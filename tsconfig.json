{
  "extends": "@salesforce/dev-config/tsconfig-strict",
  "compilerOptions": {
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "module": "Node16",
    "outDir": "./lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["node", "mocha"]
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
