{
  "extends": "@salesforce/dev-config/tsconfig-strict",
  "compilerOptions": {
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "module": "Node16",
    "outDir": "./lib",
    "rootDir": "src",
    "baseUrl": ".",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
